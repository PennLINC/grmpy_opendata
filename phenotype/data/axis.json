{
  "MeasurementToolMetadata": {
    "Description": "Clinical consensus diagnostic flags (dx_*)",
    "LongName": "Subset of the consensus diagnostic record (derived from the GOASSESS interview and clinical consensus) selected for release, sourced from the updated axis REDCap export provided by the BIT team on 2026-07-27. dx_* fields are diagnostic-category flags (binary present/absent) except dx_pscat, which is a categorical psychosis-spectrum label. No formal data dictionary was available for these fields, so descriptions below are inferred from the column names and data and should be treated as provisional (in particular dx_cogdis, dx_pdd, dx_intdis, dx_sub, dx_sub_other, and dx_pscat). Diagnoses recorded more than 365 days from the scan date were set to n/a, as were participants absent from the REDCap export.",
    "MissingValues": "n/a"
  },
